{% macro table(headers, rows, empty_message='No entries.') -%}
  {% if rows %}
  <div class="table-scroll"><table>
    <thead><tr>{% for header in headers %}<th scope="col">{{ header }}</th>{% endfor %}</tr></thead>
    <tbody>{% for row in rows %}<tr>{% for value in row %}<td>{{ value }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p class="empty">{{ empty_message }}</p>{% endif %}
{%- endmacro %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Run summary</title>
  <style>{% include 'report.css' %}</style>
</head>
<body><main>
  <header>
    <div class="eyebrow">Illumina sequencing · run report · Generated at: {{ generated_at }}</div>
    <h1>Aggregated results</h1>
    <p>Coverage metrics and sample-level reports including coverage plots, amplicon stats and variants.</p>
    {% if config_yaml %}
    <details class="config-block">
      <summary>Run configuration</summary>
      <pre><code>{{ config_yaml }}</code></pre>
    </details>
    {% endif %}
    {% if sample_sheet %}
    <details class="config-block">
      <summary>Sample sheet</summary>
      <pre><code>{{ sample_sheet }}</code></pre>
    </details>
    {% endif %}
  </header>
  <section>
    <h2>Coverage summary</h2>
    {{ table(['Sample', 'Reference', 'Mapped reads', 'Mean coverage', recovery_key], summary) }}
  </section>
  {% if samples|length > 1 or samples[0].respro_report %}
  <div class="sample-select">
    {% if samples|length > 1 %}
    <label for="select-sample">Select sample for specific results</label>
    <select id="select-sample">
      {% for sample in samples %}<option value="{{ sample.name }}">{{ sample.name }}</option>{% endfor %}
    </select>
    {% endif %}
    {% for sample in samples %}{% if sample.respro_report %}
    <a class="respro-btn" data-sample="{{ sample.name }}" href="{{ sample.respro_report }}" target="_blank" rel="noopener noreferrer"{% if not loop.first %} hidden{% endif %}>Open ResPro Report</a>
    {% endif %}{% endfor %}
  </div>
  {% endif %}
  {% for sample in samples %}
  <div class="sample-panel" data-sample="{{ sample.name }}"{% if not loop.first %} hidden{% endif %}>
    {% if sample.plots %}
    <section>
      <h2>BAMdash coverage plots</h2>
      <div class="plot-grid">
        {% for plot in sample.plots %}
        <figure>
          <figcaption>{{ plot.reference }}</figcaption>
          <img src="data:image/svg+xml;base64,{{ plot.image }}" alt="Coverage plot for {{ plot.reference }}">
        </figure>
        {% endfor %}
      </div>
    </section>
    {% endif %}
    {% if sample.amplicons %}
    <section>
      <h2>Amplicon recovery</h2>
      {% for item in sample.amplicons %}
      <h3>{{ item.reference }}</h3>
      {{ table(item.headers, item.rows) }}
      {% endfor %}
    </section>
    {% endif %}
    <section>
      <h2>Called variants</h2>
      {{ table(sample.variants.headers, sample.variants.rows, 'No variants reported for this sample.') }}
    </section>
  </div>
  {% endfor %}
</main>
{% if samples|length > 1 %}
<script>
const select = document.getElementById('select-sample');
const sync = () => {
  for (const el of document.querySelectorAll('[data-sample]')) {
    el.hidden = el.dataset.sample !== select.value;
  }
};
select.addEventListener('change', sync);
sync();
</script>
{% endif %}
</body>
</html>
